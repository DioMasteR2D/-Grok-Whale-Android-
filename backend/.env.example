# Existing SolScope Flask proxy URL (read-only; keep upstream service unchanged).
GMGN_PROXY_URL=
# Existing SoulWinners SQLite DB (read-only source option).
SOULWINNERS_DB_PATH=
# PostgreSQL used for SoulWinners integration schema and persistent paper ledger.
SOULWINNERS_DATABASE_URL=
# Read-only Solana wallet activity.
HELIUS_API_KEY=
# Optional explicit RPC endpoint; Helius RPC is used when unset and HELIUS_API_KEY exists.
SOLANA_RPC_URL=
ATLAS_SEED_WALLETS=
# Grok analysis through xAI; set as a backend secret, never commit real keys.
XAI_API_KEY=
GROK_MODEL=grok-3-mini
# Optional Jupiter API key; missing prices are never fabricated.
JUPITER_API_KEY=
# Paper-only controls.
MAX_OPEN_POSITIONS=10
ANALYSIS_PROVIDER=grok
